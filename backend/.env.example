# Copy to .env.  `python scripts/dev_postgres.py` writes DATABASE_URL here for the embedded dev database.
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/joeat
ID_HASH_SECRET=change-me
AUTH_MODE=dev
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOW_TEST_EVIDENCE=false

# LINE (leave empty for local development; the bot then runs in dry-run mode)
# Reviewer API for merchant declarations (leave empty to disable /ops/*)
OPS_API_KEY=

LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_DRY_RUN=true
LIFF_ID=
